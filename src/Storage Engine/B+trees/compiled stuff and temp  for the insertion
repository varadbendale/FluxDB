/* ---------------- printing / checking ---------------- */
static void print_tree(internal_node *root) {
    internal_node *level[1000]; int cnt = 1; level[0] = root;
    int depth = 0;
    while (cnt > 0) {
        printf("  level %d: ", depth++);
        internal_node *nxt[1000]; int ncnt = 0;
        for (int i = 0; i < cnt; i++) {
            printf("[");
            for (int j = 0; j < level[i]->num_of_leaf; j++)
                printf("%s%d", j ? " " : "", level[i]->primary_key[j]);
            printf("] ");
            if (!level[i]->leaf)
                for (int j = 0; j <= level[i]->num_of_leaf; j++) nxt[ncnt++] = level[i]->children[j];
        }
        printf("%s\n", level[0]->leaf ? "  <- leaves" : "");
        memcpy(level, nxt, ncnt * sizeof(internal_node *));
        cnt = ncnt;
    }
}

static int check_leaf_chain(internal_node *root, int expected) {
    internal_node *n = root;
    while (!n->leaf) n = n->children[0];
    int count = 0, prev = -1000000, ok = 1;
    printf("  leaf chain: ");
    for (; n; n = n->next)
        for (int i = 0; i < n->num_of_leaf; i++) {
            printf("%d ", n->primary_key[i]);
            if (n->primary_key[i] <= prev) ok = 0;
            prev = n->primary_key[i]; count++;
        }
    printf("\n  count=%d expected=%d sorted=%s -> %s\n", count, expected,
           ok ? "yes" : "NO", (ok && count == expected) ? "PASS" : "FAIL");
    return ok && count == expected;
}

static int find_key(internal_node *n, int pk) {
    while (!n->leaf) {
        int i = 0;
        while (i < n->num_of_leaf && pk >= n->primary_key[i]) i++;
        n = n->children[i];
    }
    for (int i = 0; i < n->num_of_leaf; i++) if (n->primary_key[i] == pk) return 1;
    return 0;
}

int main(void) {
    internal_node *root = (internal_node *)calloc(1, sizeof(internal_node));

    printf("TEST 1: insert 1..20 in order (no_of_data = %d)\n", no_of_data);
    for (int i = 1; i <= 20; i++) {
        printf("insert %d\n", i);
        tree_func_for_insert(root, i, NULL, i, i * 10, i % 3);
        print_tree(root);
    }
    int pass = check_leaf_chain(root, 20);

    printf("\nTEST 2: duplicates\n");
    tree_func_for_insert(root, 7, NULL, 0, 0, 0);
    tree_func_for_insert(root, 20, NULL, 0, 0, 0);

    printf("\nTEST 3: scrambled keys, 60 inserts\n");
    internal_node *root2 = (internal_node *)calloc(1, sizeof(internal_node));
    for (int i = 0; i < 60; i++) {
        int key = (i * 37) % 101 + 1;
        printf("insert %d\n", key);
        tree_func_for_insert(root2, key, NULL, i, i, i);
    }
    print_tree(root2);
    pass &= check_leaf_chain(root2, 60);

    printf("\nTEST 4: every key findable from the root\n");
    int found = 0;
    for (int i = 0; i < 60; i++) found += find_key(root2, (i * 37) % 101 + 1);
    printf("  found %d of 60 -> %s\n", found, found == 60 ? "PASS" : "FAIL");

    printf("\nOVERALL: %s\n", (pass && found == 60) ? "ALL PASS" : "SOMETHING FAILED");

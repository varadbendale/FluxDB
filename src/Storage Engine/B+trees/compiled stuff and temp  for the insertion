#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>

#define no_of_data 4
#define TRACE(fmt, ...) fprintf(stderr, "[TRACE] " fmt "\n", ##__VA_ARGS__)

typedef struct slot_data {
    int page_id;
    int file_offset;
    int slot_num;
} slot_data;

typedef struct internal_node {
    bool leaf;
    int primary_key[no_of_data + 2];
    slot_data data[no_of_data + 2];
    struct internal_node *children[no_of_data + 3];
    struct internal_node *next;
    int num_of_leaf;
    int num_of_children;
    int num_of_data_pushed;
} internal_node;

